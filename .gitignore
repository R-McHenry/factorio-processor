# Environment
.venv/
__pycache__/
*.pyc
temp/

# Run outputs. Every suite run rewrites all 22, so tracking them makes each
# commit look like the whole repo changed. The viewer reads whatever is on
# disk, so nothing depends on them being checked in.
main/results/*.results.json

# Decoded sidecars of the .bp.txt blueprints — pure derived artifacts, ~18 MB
# of them, regenerated by build_display / export_bp. The .bp.txt IS the
# deliverable; the .json is just a readable view of the same thing.
# Scoped to main/ on purpose: archive/ is kept WHOLE, and its generator is no
# longer wired up to reproduce anything.
main/**/*.bp.json
