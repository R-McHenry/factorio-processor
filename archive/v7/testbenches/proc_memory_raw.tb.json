{
  "name": "proc_memory_raw",
  "description": "Drive the v7 memory write interface directly: write_value (16) carries the value, write_trigger_set (15) makes the injector (21) pass it onto the cell's output loop, write_trigger_reset (18, signal type must match the target) clears the old hold on the cell's green input. Release all three -> the cell holds the new value, INCLUDING 0 (zero-write). Readback through ports A/B. signal-P ramps on mem_state every tick (PC autoincrement) - ignored by checks.",
  "pre_stimulus_dead_ticks": 2,
  "settle_ticks": 3,
  "poll_seconds": 0.002,
  "tick_wait_timeout_seconds": 3.0,
  "trace_ticks": 3,
  "rebuild_before_run": true,
  "paste_origin_x": 0.0,
  "paste_origin_y": 0.0,
  "fixture_blueprints": [
    {
      "name": "power_seed",
      "origin_x": 0.0,
      "origin_y": -8.0,
      "blueprint_string": "0eNqFz8EKgzAMBuB3ybnCdNVpX2UM0S5KQKO0dcxJ333RwXZcLyEh+X66QTssODviAGYDshN7MNcNPPXcDPuMmxHBAA5ogyObIKPr10Qu0HWNRYgKiO/4BJPGmwLkQIHwwxzNWvMytuhkQf3nFMyTF2HiPV3URCtYpRQS1C5dh6729BIkPX3fHkwBR5F/H1LwQOcPKC+yKteZLqtLqc95jG8gJlKg"
    }
  ],
  "restore_pause_state": true,
  "entity_map": {
    "drivers": {
      "write_value": 16,
      "trig_set": 15,
      "trig_reset": 19,
      "addr_a": 17,
      "addr_b": 24
    },
    "expected_probe_name": "mem_state",
    "output_probes": [
      { "name": "mem_state", "entity_number": 36, "wire": "red" },
      { "name": "mem_out_bus", "entity_number": 56, "wire": "green" },
      { "name": "port_a", "entity_number": 64, "wire": "green" },
      { "name": "port_b", "entity_number": 65, "wire": "green" },
      { "name": "instr_port", "entity_number": 66, "wire": "green" }
    ]
  },
  "timeline": [
    {
      "name": "write_s0_42",
      "drive": {
        "write_value": { "signal-0": 42 },
        "trig_set": { "signal-0": 1 },
        "trig_reset": { "signal-0": 1 }
      },
      "expect": { "signal-0": 42 }
    },
    {
      "name": "release_write_hold_42",
      "drive": { "write_value": {}, "trig_set": {}, "trig_reset": {} },
      "trace_ticks": 4,
      "expect": { "signal-0": 42 }
    },
    {
      "name": "read_addr1_via_port_a",
      "drive": { "addr_a": { "signal-R": 1 } },
      "settle_ticks": 3,
      "expect_probe": "port_a",
      "expect": { "signal-0": 42 }
    },
    {
      "name": "override_s0_99",
      "drive": {
        "write_value": { "signal-0": 99 },
        "trig_set": { "signal-0": 1 },
        "trig_reset": { "signal-0": 1 }
      },
      "expect": { "signal-0": 99 }
    },
    {
      "name": "release_hold_99",
      "drive": { "write_value": {}, "trig_set": {}, "trig_reset": {} },
      "expect": { "signal-0": 99 }
    },
    {
      "name": "port_a_sees_override",
      "settle_ticks": 3,
      "expect_probe": "port_a",
      "expect": { "signal-0": 99 }
    },
    {
      "name": "write_second_signal_s1_7",
      "drive": {
        "write_value": { "signal-1": 7 },
        "trig_set": { "signal-1": 1 },
        "trig_reset": { "signal-1": 1 }
      },
      "expect": { "signal-1": 7 }
    },
    {
      "name": "release_both_held",
      "drive": { "write_value": {}, "trig_set": {}, "trig_reset": {} },
      "expect": { "signal-0": 99, "signal-1": 7 }
    },
    {
      "name": "read_addr6_signal1_via_port_b",
      "drive": { "addr_b": { "signal-R": 6 } },
      "settle_ticks": 3,
      "expect_probe": "port_b",
      "expect": { "signal-1": 7 }
    },
    {
      "name": "zero_write_clears_s1",
      "drive": {
        "trig_set": { "signal-1": 1 },
        "trig_reset": { "signal-1": 1 }
      },
      "trace_ticks": 4,
      "expect": { "signal-1": 0, "signal-0": 99 }
    },
    {
      "name": "zero_write_holds_after_release",
      "drive": { "trig_set": {}, "trig_reset": {} },
      "trace_ticks": 4,
      "expect": { "signal-1": 0, "signal-0": 99 }
    },
    {
      "name": "port_b_confirms_zero",
      "settle_ticks": 3,
      "expect_probe": "port_b",
      "expect": { "signal-1": 0 }
    }
  ]
}
