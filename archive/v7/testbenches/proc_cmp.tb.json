      },
      "settle_ticks": 3,
      "expect_probe": "port_a",
      "expect": {
        "signal-T": 5
      }
    },
    {
      "name": "carrier_leak_gone_read_empty_addr1",
      "drive": {
        "addr_a": {
          "signal-R": 1
        }
      },
      "settle_ticks": 3,
      "expect_probe": "port_a",
      "expect": {
        "signal-R": 0,
        "signal-T": 0
      }
    }
  ]
