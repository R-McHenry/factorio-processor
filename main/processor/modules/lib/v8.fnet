# lib/v8.fnet — shared combinator templates for the fnet v8 rebuild.
# Each control_behavior body is verbatim from the v8 master
# (modules/processor_v8.source.json); entity numbers cited are the master's.
# Grown component by component (NETLIST_PLAN.md "v8 baseline").

# Generic stimulus / config constant. [param0] = player_description; benches
# rewrite the filters at run time (entity_map.drivers), so it starts empty.
stim = constant-combinator({
  "player_description": "[param0]",
  "sections": { "sections": [ { "index": 1, "filters": [] } ] }
});

# Write injector (master 22): while the set bus (red) is non-zero, pass every
# signal on the value bus (green) onto the memory cell's output loop.
# ≠ (≠) keeps negative set pulses working.
v8_injector = decider-combinator({
  "player_description": "injector",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-anything" },
        "comparator": "≠",
        "first_signal_networks": { "red": true, "green": false } }
    ],
    "outputs": [
      { "signal": { "type": "virtual", "name": "signal-everything" },
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": []
  }
});

# Memory cell (master 36): per signal, keep the held (red self-loop) value
# while the reset bus (green) is ≤ 0. A +1 reset pulse breaks the hold for
# that signal; the accumulate mask's standing -1 cancels the pulse so writes
# ADD instead. ≠ on red keeps negative values held.
v8_cell = decider-combinator({
  "player_description": "mem_cell",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-each" },
        "comparator": "≠",
        "first_signal_networks": { "red": true, "green": false } },
      { "first_signal": { "type": "virtual", "name": "signal-each" },
        "comparator": "≤",
        "first_signal_networks": { "red": false, "green": true },
        "compare_type": "and" }
    ],
    "outputs": [
      { "signal": { "type": "virtual", "name": "signal-each" },
        "networks": { "red": true, "green": false } }
    ],
    "else_outputs": []
  }
});

# Accumulate mask (v8's write_trigger_reset config role, split into its own
# combinator per V8.md TODO 7): filters are GENERATED by the compiler from
# the design's `accumulate` declarations — a -1 per accumulate row, riding
# the reset bus permanently.
accum_mask = constant-combinator({
  "accumulate_mask": true,
  "player_description": "accumulate_mask"
});

# Scalar converter (masters 2, 9, 37, 38, 39, 40): sum every input signal
# into the scalar carrier [param0]. [param1] = player_description.
sum_to = arithmetic-combinator({
  "player_description": "[param1]",
  "arithmetic_conditions": {
    "first_signal": { "type": "virtual", "name": "signal-each" },
    "second_constant": 0,
    "operation": "+",
    "output_signal": { [param0] }
  }
});

# Write-address latch (master 3): while the green input carries anything
# > 0, pass the green face; else hold the last address via the red
# self-loop. (Port A's a_rd_latch is the ≠ variant — separate template
# when that component lands.)
v8_addr_latch = decider-combinator({
  "player_description": "write_addr_latch",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-anything" },
        "comparator": ">",
        "first_signal_networks": { "red": false, "green": true } }
    ],
    "outputs": [
      { "signal": { "type": "virtual", "name": "signal-everything" },
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": [
      { "signal": { "type": "virtual", "name": "signal-everything" },
        "networks": { "red": true, "green": false } }
    ]
  }
});

# One-hot decode (master 8): emit 1 on each address-table row (red) whose
# value equals the scalar [param0] (green).
v8_onehot = decider-combinator({
  "player_description": "write_onehot",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-each" },
        "second_signal": { [param0] },
        "comparator": "=",
        "first_signal_networks": { "red": true, "green": false },
        "second_signal_networks": { "red": false, "green": true } }
    ],
    "outputs": [
      { "signal": { "type": "virtual", "name": "signal-each" },
        "copy_count_from_input": false,
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": []
  }
});

# Flag emitter (master 10): [param0] = 1 while anything rides the red
# input. [param1] = player_description.
v8_flag_if_any = decider-combinator({
  "player_description": "[param1]",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-anything" },
        "comparator": ">",
        "first_signal_networks": { "red": true, "green": false } }
    ],
    "outputs": [
      { "signal": { [param0] },
        "copy_count_from_input": false,
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": []
  }
});

# Scalar product (masters 13, 14): each (red) x scalar [param0] (green) ->
# each. [param1] = player_description.
v8_mul_scalar = arithmetic-combinator({
  "player_description": "[param1]",
  "arithmetic_conditions": {
    "first_signal": { "type": "virtual", "name": "signal-each" },
    "second_signal": { [param0] },
    "operation": "*",
    "output_signal": { "type": "virtual", "name": "signal-each" },
    "first_signal_networks": { "red": true, "green": false },
    "second_signal_networks": { "red": false, "green": true }
  }
});

# Route-bit mask (masters 21/28/31/43/48/55/61/68/70/72/74/76): each AND
# [param0] over the instruction bus (green in), result on both output
# faces — red feeds the route gate, green feeds the write-trigger sensor
# (bit 2 only). [param1] = player_description.
v8_route_mask = arithmetic-combinator({
  "player_description": "[param1]",
  "arithmetic_conditions": {
    "first_signal": { "type": "virtual", "name": "signal-each" },
    "second_constant": [param0],
    "operation": "AND",
    "output_signal": { "type": "virtual", "name": "signal-each" }
  }
});

# Route gate (masters 20/27/30/42/47/54/60/67/69/71/73/75): while the
# masked route bit (red) is non-zero, pass the data bus (green) through.
# [param0] = player_description.
v8_route_gate = decider-combinator({
  "player_description": "[param0]",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-anything" },
        "comparator": ">",
        "first_signal_networks": { "red": true, "green": false } }
    ],
    "outputs": [
      { "signal": { "type": "virtual", "name": "signal-everything" },
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": []
  }
});

# Immediate extractor (master 77): instruction >> 12 = the 20-bit imm,
# feeding the constant-route gates' data bus.
v8_shr12 = arithmetic-combinator({
  "player_description": "imm_shift",
  "arithmetic_conditions": {
    "first_signal": { "type": "virtual", "name": "signal-each" },
    "second_constant": 12,
    "operation": ">>",
    "output_signal": { "type": "virtual", "name": "signal-each" }
  }
});

# Green-condition flag emitter (master 5): [param0] = 1 while anything
# rides the GREEN input (the red-input variant is v8_flag_if_any).
# [param1] = player_description.
v8_flag_if_any_g = decider-combinator({
  "player_description": "[param1]",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-anything" },
        "comparator": ">",
        "first_signal_networks": { "red": false, "green": true } }
    ],
    "outputs": [
      { "signal": { [param0] },
        "copy_count_from_input": false,
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": []
  }
});

# ALU op (masters 32-35): [param0] op [param2] -> [param3], reading the red
# state bus, result summed onto the green memory bus. [param4] =
# player_description. Operand/result signals are memory[...] rows.
v8_alu_op = arithmetic-combinator({
  "player_description": "[param4]",
  "arithmetic_conditions": {
    "first_signal": { [param0] },
    "second_signal": { [param1] },
    "operation": "[param2]",
    "output_signal": { [param3] }
  }
});

# CMP select (masters 49/50): if [param0] [param2] [param1], pass [param0]'s
# value, else [param1]'s — "<" gives MIN, ">" gives MAX. The raw output
# rides the winner's own row signal; a sum_to collapses it to the S/T row.
# [param3] = player_description.
v8_cmp_select = decider-combinator({
  "player_description": "[param3]",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { [param0] },
        "second_signal": { [param1] },
        "comparator": "[param2]" }
    ],
    "outputs": [ { "signal": { [param0] } } ],
    "else_outputs": [ { "signal": { [param1] } } ]
  }
});

# CMP flag (masters 51/52): [param3] = 1 while [param0] [param2] [param1].
# [param4] = player_description.
v8_cmp_flag = decider-combinator({
  "player_description": "[param4]",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { [param0] },
        "second_signal": { [param1] },
        "comparator": "[param2]" }
    ],
    "outputs": [
      { "signal": { [param3] }, "copy_count_from_input": false }
    ],
    "else_outputs": []
  }
});

# Park latch (master 23, a_rd_latch): while the green input carries
# anything ≠ 0, pass the green face (new park address); else hold via the
# red self-loop. The ≠ keeps negative parks working. [param0] =
# player_description.
v8_park_latch = decider-combinator({
  "player_description": "[param0]",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-anything" },
        "comparator": "≠",
        "first_signal_networks": { "red": false, "green": true },
        "second_signal_networks": { "red": true, "green": false } }
    ],
    "outputs": [
      { "signal": { "type": "virtual", "name": "signal-everything" },
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": [
      { "signal": { "type": "virtual", "name": "signal-everything" },
        "networks": { "red": true, "green": false } }
    ]
  }
});

# Port read decider (masters 56/57/58): emit the green-bus value of the
# table row (red) whose value equals the carrier [param0] (also red — the
# carrier is summed onto the table net, which is why it must be excluded
# from the address space). [param1] = player_description.
v8_port_read = decider-combinator({
  "player_description": "[param1]",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-each" },
        "second_signal": { [param0] },
        "comparator": "=",
        "first_signal_networks": { "red": true, "green": false },
        "second_signal_networks": { "red": true, "green": false } }
    ],
    "outputs": [
      { "signal": { "type": "virtual", "name": "signal-each" },
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": []
  }
});

# Memory-map gate (master 53): pass the green-bus value of every signal
# present on the red mask input (≠0 both sides — negatives read). Port B's
# read address IS the gated register row's value.
v8_mmap_gate = decider-combinator({
  "player_description": "mmap_gate",
  "decider_conditions": {
    "conditions": [
      { "first_signal": { "type": "virtual", "name": "signal-each" },
        "comparator": "≠",
        "first_signal_networks": { "red": true, "green": false } },
      { "first_signal": { "type": "virtual", "name": "signal-each" },
        "comparator": "≠",
        "first_signal_networks": { "red": false, "green": true },
        "compare_type": "and" }
    ],
    "outputs": [
      { "signal": { "type": "virtual", "name": "signal-each" },
        "networks": { "red": false, "green": true } }
    ],
    "else_outputs": []
  }
});

# One-filter config constant (masters 59 mmap_addr, 29 pc_autoincrement):
# [param0] = [param1], permanently. [param2] = player_description.
v8_mask_const = constant-combinator({
  "player_description": "[param2]",
  "sections": { "sections": [ { "index": 1, "filters": [
    { "index": 1, [param0], "comparator": "=", "count": [param1] }
  ] } ] }
});

# Signal-to-signal converter (master 39): [param0] + 0 -> [param1] (the
# PC row's value becomes the instruction-port carrier). [param2] =
# player_description.
v8_sig_to = arithmetic-combinator({
  "player_description": "[param2]",
  "arithmetic_conditions": {
    "first_signal": { [param0] },
    "second_constant": 0,
    "operation": "+",
    "output_signal": { [param1] }
  }
});

# Address table (masters 6, 44, 45, 46): the design's address space,
# populated over RCON at paste via the signal_table marker (the compiler
# stamps the design's exclusion set onto it).
addr_table = constant-combinator({
  "player_description": "address_table",
  "signal_table": { "table": "full_address_space" },
  "sections": { "sections": [ { "index": 1, "filters": [] } ] }
});
